# Engagement working data — findings, audit logs, reports, generated hardening.
# These can contain sensitive results; never commit them. The example scope
# template and the engagements README are kept.
engagements/*/
!engagements/example/
engagements/example/*
!engagements/example/scope.yaml
!engagements/README.md

